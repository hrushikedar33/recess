<?xml version="1.0" encoding="utf-8"?>
<!--
    Expanded look of the limit notification. Android allows roughly 256 dp for custom expanded
    content, so the budget is: header, a 3-line quote, a goals header and at most three goal rows
    plus a "+N more" line. The full list is one tap away on the Break screen.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="2dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/notif_card"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/notif_badge"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/notif_badge"
                android:gravity="center"
                android:text="@string/cover_emoji"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/notif_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:maxLines="1"
                    android:textColor="@color/recess_text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/notif_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/recess_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <Chronometer
                android:id="@+id/notif_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/notif_pill"
                android:fontFamily="sans-serif-black"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textColor="@color/recess_blocked"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/notif_tomorrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/notif_pill"
                android:fontFamily="sans-serif-black"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="@string/notif_back_tomorrow"
                android:textColor="@color/recess_blocked"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/notif_quote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/recess_text_primary"
            android:textSize="13sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/notif_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/recess_text_secondary"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="@color/recess_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/notif_goals_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="@string/notif_goals_header"
                android:textAllCaps="true"
                android:textColor="@color/recess_primary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/notif_goals_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/recess_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/notif_goal_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/recess_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/notif_goal_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/recess_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/notif_goal_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/recess_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/notif_goals_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/recess_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/notif_goals_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:textColor="@color/recess_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
