<?xml version="1.0" encoding="utf-8"?>
<!-- Heads-up and collapsed look of the limit notification: badge, headline, one line of quote, countdown. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="2dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/notif_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/notif_badge"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/notif_badge"
            android:gravity="center"
            android:text="@string/cover_emoji"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:textColor="@color/recess_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/notif_quote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/recess_text_secondary"
                android:textSize="12sp"
                android:textStyle="italic" />
        </LinearLayout>

        <Chronometer
            android:id="@+id/notif_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/notif_pill"
            android:fontFamily="sans-serif-black"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textColor="@color/recess_blocked"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/notif_tomorrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/notif_pill"
            android:fontFamily="sans-serif-black"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="@string/notif_back_tomorrow"
            android:textColor="@color/recess_blocked"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
